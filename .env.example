# Local development env. Copy to .env and source it (set -a; . ./.env; set +a).
# In Databricks Apps these are provided via app.yaml + injected DATABRICKS_* vars.

# Auth for LOCAL dev only — the deployed App uses its service principal automatically.
DATABRICKS_CONFIG_PROFILE=fe-vm-boc

# Workspace
DATABRICKS_HOST=https://fevm-serverless-stable-qr9if1.cloud.databricks.com

# Foundry serving endpoints (model= is the endpoint name)
FOUNDRY_FAST_ENDPOINT=foundry-fast
FOUNDRY_REASONING_ENDPOINT=foundry-reasoning
FOUNDRY_EMBEDDING_ENDPOINT=foundry-embedding

# Unity Catalog namespace
UC_CATALOG=shm_catalog
UC_SCHEMA=boc_demo

# SQL warehouse (for the anomaly UC function)
SQL_WAREHOUSE_ID=d94339f8fe9c593a

# Vector Search
VS_ENDPOINT=boc-vs-endpoint
VS_INDEX=shm_catalog.boc_demo.policy_docs_index

# Genie space
GENIE_SPACE_ID=01f166aad95716d1995c011a0473f1d7

# Anomaly UC function
UC_ANOMALY_FUNCTION=shm_catalog.boc_demo.detect_market_anomaly

# MLflow experiment for traces/sessions/feedback
MLFLOW_EXPERIMENT_ID=574544292485229
