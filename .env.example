# Local development env. Copy to .env and source it (set -a; . ./.env; set +a).
# In Databricks Apps these are provided via app.yaml + injected DATABRICKS_* vars.

# Auth for LOCAL dev only — the deployed App uses its service principal automatically.
DATABRICKS_CONFIG_PROFILE=fe-vm-shm-skunkworks

# Workspace
DATABRICKS_HOST=https://fevm-shm-skunkworks.cloud.databricks.com

# Serving endpoints (native GPT-5 family; model= is the endpoint name)
FAST_ENDPOINT=databricks-gpt-5-mini
REASONING_ENDPOINT=databricks-gpt-5
EMBEDDING_ENDPOINT=databricks-gte-large-en

# Unity Catalog: two schemas mirroring the customer's layout
UC_CATALOG=shm_catalog
VIEWS_SCHEMA=views_db
METADATA_SCHEMA=metadata_db

# SQL warehouse (for the UC functions)
SQL_WAREHOUSE_ID=505ec857e6b4ea23

# Vector Search
VS_ENDPOINT=boc-vs-endpoint
VS_INDEX=shm_catalog.metadata_db.instruction_chunks_index

# Genie space (set after create_genie_space.py --create)
GENIE_SPACE_ID=

# MLflow experiment for traces/sessions/feedback
MLFLOW_EXPERIMENT_ID=652880451028517
